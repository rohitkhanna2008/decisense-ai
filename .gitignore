# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mpl_cache/

# Virtual environments & secrets
.venv/
venv/
env/
ENV/
.env
.streamlit/secrets.toml

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Audio recordings - ignore raw field data but preserve directory via .gitkeep
data/raw_recordings/*
!data/raw_recordings/.gitkeep

# Explicitly keep deployment datasets, spatial geojson, sample WAVs, and evaluation outputs tracked
!data/*.csv
!data/*.geojson
!data/*.json
!data/sample_wavs/
!data/sample_wavs/*
!outputs/
!outputs/*
